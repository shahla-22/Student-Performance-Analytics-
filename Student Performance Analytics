import java.util.Scanner;
import java.util.ArrayList;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Student Management System");
        System.out.print("Enter number of students: ");
        int number_of_student = scanner.nextInt();

        if (number_of_student <= 20) {
            System.out.println("Invalid Number Of Students");
        } else {
            ArrayList<Integer> list_students_marks = new ArrayList<>();
            for (int i = 0; i < number_of_student; i++) {
                System.out.print("Enter marks for student " + (i + 1) + ": ");
                int marks = scanner.nextInt();
                list_students_marks.add(marks);
            }
            System.out.println("List of student marks: " + list_students_marks);
        }
        scanner.close();
    }
}
